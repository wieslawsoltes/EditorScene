<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(EditorSceneTargetFrameworks)' != ''">$(EditorSceneTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <ApplicationTitle>EditorScene</ApplicationTitle>
    <ApplicationId>com.wieslawsoltes.editorscene</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmShellMonoRuntimeExecutionMode>Interpreter</WasmShellMonoRuntimeExecutionMode>
    <WasmShellEnableThreading>false</WasmShellEnableThreading>
    <!-- Audit transitive dependencies too; do not suppress security diagnostics. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Roslyn is not trim-safe. Retain its compiler metadata/reflection paths instead of suppressing IL2104. -->
    <PublishTrimmed Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">false</PublishTrimmed>
    <WasmShellWebAppBasePath Condition="'$(WasmShellWebAppBasePath)' == ''">/EditorScene/</WasmShellWebAppBasePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EditorScene.Controls/EditorScene.Controls.csproj" />
    <ProjectReference Include="../EditorScene.Languages.DotNet/EditorScene.Languages.DotNet.csproj" />
    <ProjectReference Include="../EditorScene.Languages.Structured/EditorScene.Languages.Structured.csproj" />
    <ProjectReference Include="../EditorScene.Protocol/EditorScene.Protocol.csproj" />
    <!-- Override vulnerable transitive 10.0.12 references; October 2026 Microsoft advisories fix both in 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
