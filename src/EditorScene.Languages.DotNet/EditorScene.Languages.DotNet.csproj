<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Reusable EditorScene.Languages.DotNet component for native and browser code editing.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EditorScene.LanguageServices/EditorScene.LanguageServices.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
  </ItemGroup>
  <Target Name="EmbedEditorReferenceAssemblies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'">
        <LogicalName>EditorScene.Reference.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
